{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run typecheck && pnpm run build:client && pnpm run build:server && pnpm run prerender",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vitest": "3.2.4",
    "wouter": "^3.3.5"
  },
  "dependencies": {
    "swiper": "^12.1.4",
    "yet-another-react-lightbox": "^3.32.0"
  }
}
